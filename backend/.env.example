# --- Speech-to-Text: "local" (faster-whisper) or "cloud" (OpenAI Whisper API)
STT_ENGINE=local

# Local model: tiny | base | small | medium | large-v3
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# Cloud
WHISPER_CLOUD_MODEL=whisper-1

# --- LLM (OpenAI-compatible) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Optional: point at a local OpenAI-compatible server (vLLM, llama.cpp, LM Studio)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30.0

# --- Secrets ---
OPENAI_API_KEY=

# --- Session tuning ---
SESSION_MAX_TURNS=10
MAX_AUDIO_BYTES=15728640