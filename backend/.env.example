# --- Speech-to-Text: "local" (faster-whisper) or "cloud" (OpenAI Whisper API)
STT_ENGINE=local

# Local model: tiny | base | small | medium | large-v3
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# Cloud (OpenAI Whisper API)
WHISPER_CLOUD_MODEL=whisper-1

# --- LLM provider: "gemini" (default, LlamaIndex), "mistral", or "openai" ---
LLM_PROVIDER=gemini

# Gemini (via llama-index-llms-gemini)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Mistral fallback (via llama-index-llms-mistralai). Auto-used when Gemini (or
# OpenAI) fails, or make it the primary with LLM_PROVIDER=mistral.
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=

# Hard cap on LLM response tokens (keeps free-tier billing predictable)
LLM_MAX_TOKENS=600

# Rate-limit backoff (tenacity). Retry-After headers from the provider are
# honoured and capped at LLM_MAX_WAIT_SECONDS.
LLM_BACKOFF_MIN_SECONDS=2.0
LLM_BACKOFF_MAX_SECONDS=30.0
LLM_MAX_ATTEMPTS=4
LLM_MAX_WAIT_SECONDS=60.0

# OpenAI / OpenAI-compatible (LLM_BASE_URL for local vLLM/llama.cpp)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30.0

# --- Conversation memory (LlamaIndex ChatMemoryBuffer + summarization) ---
MEMORY_TOKEN_LIMIT=1800
MEMORY_SUMMARIZE_EVERY=6
MEMORY_KEEP_RECENT=4

# --- Stemmer diagnostics (deterministic pre-LLM analysis) ---
STEMMER_DIAGNOSTICS=true

# --- Session tuning ---
SESSION_MAX_TURNS=10
MAX_AUDIO_BYTES=15728640

# --- Text-to-Speech (edge-tts, free, no key): "edge" or "none" ---
# sw-KE-ZuriNeural (f) | sw-KE-RafikiNeural (m) | sw-TZ-RehemaNeural (f) | sw-TZ-DaudiNeural (m)
TTS_ENGINE=edge
TTS_VOICE=sw-KE-ZuriNeural
TTS_RATE=+0%

# --- Secrets ---
OPENAI_API_KEY=
